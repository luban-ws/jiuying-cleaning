{
  "name": "cleaning",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "description": "macOS clean app - browser, Docker, AI tools space management",
  "scripts": {
    "dev": "pnpm --filter @cleanspace/desktop dev",
    "build": "pnpm --filter @cleanspace/desktop build",
    "build:app": "pnpm --filter @cleanspace/desktop build:app",
    "build:app:dev": "pnpm --filter @cleanspace/desktop build:app:dev",
    "open:app": "pnpm --filter @cleanspace/desktop open:app",
    "open:app:dev": "pnpm --filter @cleanspace/desktop open:app:dev",
    "test:velox-profile": "pnpm --filter @cleanspace/desktop test:velox-profile",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.0.11"
  }
}
