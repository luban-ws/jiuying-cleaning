{
  "name": "@cleanspace/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CleanSpace desktop — Velox + React + Swift",
  "scripts": {
    "velox:cli:build": "cd desktop-velox/.build/checkouts/velox && swift build --product velox",
    "velox": "cd desktop-velox && .build/checkouts/velox/.build/debug/velox",
    "dev": "pnpm run velox dev",
    "build": "pnpm run build:app",
    "build:app": "VELOX_BUNDLE_CONFIGURATION=release pnpm run velox build --bundle",
    "build:app:dev": "node scripts/run-velox-profile.mjs build:app",
    "open:app": "open desktop-velox/.build/release/Cleaning.app",
    "open:app:dev": "open 'desktop-velox/.build/debug/Cleaning Dev.app'",
    "test:velox-profile": "node --test scripts/velox-profile-config.test.mjs"
  },
  "dependencies": {
    "@cleanspace/desktop-api": "workspace:*",
    "@radix-ui/react-select": "^2.3.7",
    "lucide-react": "^1.27.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.5"
  }
}
