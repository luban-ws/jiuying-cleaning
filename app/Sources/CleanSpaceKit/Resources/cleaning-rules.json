[
  {
    "id": "trash",
    "category": "system",
    "name": "废纸篓",
    "type": "dir",
    "risk": "low",
    "paths": [
      { "base": "~/.Trash", "dirs": ["*"] }
    ]
  },
  {
    "id": "user-caches",
    "category": "system",
    "name": "用户缓存",
    "type": "dir",
    "risk": "medium",
    "warning": "部分缓存能加速应用；清理后首次打开相关应用可能较慢。",
    "paths": [
      { "base": "~/Library/Caches", "dirs": ["*"] }
    ]
  },
  {
    "id": "xcode-derived-data",
    "category": "system",
    "name": "Xcode DerivedData",
    "type": "dir",
    "risk": "low",
    "warning": "清理后下次编译会稍慢。",
    "paths": [
      { "base": "~/Library/Developer/Xcode/DerivedData", "dirs": ["*"] }
    ]
  },
  {
    "id": "xcode-archives",
    "category": "system",
    "name": "Xcode 归档 (Archives)",
    "type": "dir",
    "risk": "low",
    "paths": [
      { "base": "~/Library/Developer/Xcode/Archives", "dirs": ["*"] }
    ]
  },
  {
    "id": "chrome-cache",
    "category": "browser",
    "name": "Chrome 缓存",
    "type": "dir",
    "risk": "low",
    "paths": [
      { "base": "~/Library/Caches/Google/Chrome", "dirs": ["*"] },
      { "base": "~/Library/Application Support/Google/Chrome", "dirs": ["Default/Application Cache", "Default/Code Cache", "Default/GPUCache"] }
    ]
  },
  {
    "id": "chrome-cookies-history",
    "category": "browser",
    "name": "Chrome Cookie 与历史",
    "type": "dir",
    "risk": "medium",
    "warning": "将清除网站登录状态与浏览历史。",
    "paths": [
      { "base": "~/Library/Application Support/Google/Chrome/Default", "dirs": ["Cookies", "History", "Local Storage"] }
    ]
  },
  {
    "id": "safari-cache",
    "category": "browser",
    "name": "Safari 缓存",
    "type": "dir",
    "risk": "low",
    "paths": [
      { "base": "~/Library/Caches/com.apple.Safari", "dirs": ["*"] }
    ]
  },
  {
    "id": "safari-local-storage",
    "category": "browser",
    "name": "Safari 本地存储与数据库",
    "type": "dir",
    "risk": "medium",
    "warning": "将清除网站本地存储与数据库，可能重置站点数据。",
    "paths": [
      { "base": "~/Library/Safari", "dirs": ["LocalStorage", "Databases"] }
    ]
  },
  {
    "id": "safari-history",
    "category": "browser",
    "name": "Safari 历史记录",
    "type": "dir",
    "risk": "medium",
    "warning": "将清除浏览器历史记录。",
    "paths": [
      { "base": "~/Library/Safari", "dirs": ["History.db", "History.db-wal", "History.db-shm"] }
    ]
  },
  {
    "id": "firefox-cache",
    "category": "browser",
    "name": "Firefox 缓存",
    "type": "dir",
